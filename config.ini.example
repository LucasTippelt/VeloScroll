# VeloScroll daemon configuration
# ================================

[veloscroll]

; --- feel ----------------------------------------------------------------------

DPI = 1600 
; your mouse's current DPI (counts/inch), not its maximum.
DEADZONE_IN = 0.05
; Inches from the press point below which nothing scrolls.
FULL_IN = 2.5
; Inches from the press point at which MAX_RATE is reached (must be > DEADZONE_IN).
MAX_RATE = 130.0
; Notches per second at FULL_IN and beyond (your top scrolling speed).
MIN_RATE = 4.0
; Notches per second just past the deadzone (the floor of the ramp, keep > 0).
CURVE = 0.5
; Shape of the speed ramp: >1 gentle near the start, =1 linear, <1 steep near the start.
OUT_SMOOTH = 0.8
; 0..1 how quickly the rate follows the target (lower = smoother, higher = snappier).
INVERT = False
; True/False: flip scroll direction (set true if your DE has "natural scrolling" enabled).
TICK = 0.004
; ticker loop period in seconds (0.004 s ≈ 250 Hz); not a feel setting, only lower it if scrolling still looks steppy (more CPU).

; --- feel --- horizontal ramp overrides (optional) ---------------------------------------

; Per-axis variants of the ramp above, used only while SCROLL_BTN_H is held. Each key falls back to its vertical counterpart when unset 
; or `none`, so you can override just one by uncommenting (e.g. a shorter horizontal deadzone).
;DEADZONE_IN_H = 0.1
;FULL_IN_H = 3.0
;MIN_RATE_H = 8.0
;MAX_RATE_H = 90.0
;CURVE_H = 1.2
;OUT_SMOOTH_H = 0.7

; --- device selection ----------------------------------------------------------

;NAME_MATCH = Fallback
; fallback selector (used only when DEVICE_MATCH is none): case-insensitive substring of your mouse's name.

DEVICE_MATCH = 0x12d, 0x3456 
; recommended precise selector that overrides NAME_MATCH. Accepted syntaxes:
; = 0x46d, 0x4093        (Preferred) USB ID pair in hex (comma or whitespace separated)
; = 1133 16531           the same pair in decimal (don't know why you would ever use this, but you do you)
; = /dev/input/by-id/usb-Logitech_G_Pro_X_Superlight_2-event-mouse    stable path string (two identical mice; pins the USB port)
; = none                 fall back to NAME_MATCH (not recommended)

SCROLL_BTN = BTN_SIDE
; key code of the button that enables veloscroll when held: evdev name or decimal code 
; using decimal code from "Finding your device name & activation button" is easiest 
; `none` is not allowed.

SCROLL_BTN_H = none
; optional second hold button for HORIZONTAL velocity scrolling: driven by mouse X movement
; evdev name or decimal code
; `none` disables (default)
; must differ from SCROLL_BTN/DISABLED_BTN.

DISABLED_BTN = none
; key code of a button that is swallowed entirely and does nothing else: evdev name or decimal code
; `none` disables this feature (default)

; --- logging -------------------------------------------------------------------

LOG_LEVEL = 2
; LOG_LEVEL — what the daemon writes to its log (`journalctl -u veloscroll`). Integer 0..3, higher = more verbose; hot-reloaded like every other key.
;   0 = errors only (device busy, permission problems, lost device)
;   1 = + normal events (grabbed <device>, no matching device yet, config loaded at startup)
;   2 = + config detail (unknown keys/sections ignored, reload rejected, config reloaded old->new, virtual mouse ID changes) — default
;   3 = + debug (e.g. a device being released because the config no longer selects it)
; Note: lowering LOG_LEVEL below 2 also hides the "config reloaded:" confirmation line itself.

; --- latency -------------------------------------------------------------------

LATENCY_LOG = False
; LATENCY_LOG — True/False: collect per-event timing and log one summary line per second, plus a computed
; latency model on startup/config change. Debugging only; lines are independent of LOG_LEVEL.